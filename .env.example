# Copy to ~/.config/fb-to-ebay/.env and fill in your eBay developer keys.
# Keys come from https://developer.ebay.com/my/keys (sandbox and production are separate sets).

# App ID (Client ID)
EBAY_APP_ID=your-app-id-here

# Cert ID (Client Secret)
EBAY_CERT_ID=your-cert-id-here

# Dev ID
EBAY_DEV_ID=your-dev-id-here

# RuName — eBay's identifier for your registered redirect URI.
# Set this up in the developer portal under "User tokens" → "Get a token from eBay via your application"
EBAY_RUNAME=your-runame-here

# sandbox or production. Always start with sandbox.
EBAY_ENV=sandbox

# Optional. Defaults to EBAY_US.
# Other options: EBAY_GB, EBAY_AU, EBAY_CA, EBAY_DE, etc.
# EBAY_MARKETPLACE_ID=EBAY_US
