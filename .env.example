# Copy to ~/.config/ebay-lister/.env and fill in your eBay developer keys.
# Keys come from https://developer.ebay.com/my/keys (sandbox and production
# are separate keysets — they have different App ID / Cert ID / Dev ID values
# and different RuNames).

# Active environment: sandbox or production. Switch envs by changing this line
# only — credential blocks below are read based on this value.
EBAY_ENV=sandbox


# ────── Sandbox credentials ──────
EBAY_SANDBOX_APP_ID=your-sandbox-app-id-here
EBAY_SANDBOX_CERT_ID=your-sandbox-cert-id-here
EBAY_SANDBOX_DEV_ID=your-sandbox-dev-id-here
EBAY_SANDBOX_RUNAME=your-sandbox-runame-here

# Sandbox business policy IDs + merchant location key (created via Account API
# after opting in to SELLING_POLICY_MANAGEMENT — see README step 6).
# EBAY_SANDBOX_FULFILLMENT_POLICY_ID=
# EBAY_SANDBOX_PAYMENT_POLICY_ID=
# EBAY_SANDBOX_RETURN_POLICY_ID=
# EBAY_SANDBOX_MERCHANT_LOCATION_KEY=default


# ────── Production credentials ──────
# EBAY_PRODUCTION_APP_ID=your-prod-app-id-here
# EBAY_PRODUCTION_CERT_ID=your-prod-cert-id-here
# EBAY_PRODUCTION_DEV_ID=your-prod-dev-id-here
# EBAY_PRODUCTION_RUNAME=your-prod-runame-here

# Production business policy IDs + merchant location key (create at
# https://www.ebay.com/sh/policies or via the Account API).
# EBAY_PRODUCTION_FULFILLMENT_POLICY_ID=
# EBAY_PRODUCTION_PAYMENT_POLICY_ID=
# EBAY_PRODUCTION_RETURN_POLICY_ID=
# EBAY_PRODUCTION_MERCHANT_LOCATION_KEY=default


# ────── Shared settings (apply to both envs) ──────

# Optional. Defaults to EBAY_US.
# Other options: EBAY_GB, EBAY_AU, EBAY_CA, EBAY_DE, etc.
# EBAY_MARKETPLACE_ID=EBAY_US

# Per-listing defaults — when set, the skill workflow won't ask about these
# every time you publish. Override per-listing by including the field in the
# draft JSON (see references/draft_schema.md).
# EBAY_DEFAULT_HANDLING_DAYS=2          # Business days between sale and drop-off
# EBAY_OFFER_LOCAL_PICKUP=true          # Offer local pickup as a shipping option
# EBAY_SHIP_INTERNATIONALLY=false       # Enable international shipping

# Carrier service codes offered to buyers (comma-separated). Defaults are US
# (USPS) — non-US sellers should override with their carrier's codes.
# Sandbox-friendly default works in both envs. Find valid codes via the
# Trading API GeteBayDetails call (DetailName=ShippingServiceDetails).
# Caveats:
#   - Only services that support CALCULATED rates work in the default policy.
#   - In production, sellers may prefer USPSGroundAdvantage,USPSPriority.
#   - UK example: RoyalMailFirstClassStandard,RoyalMailSecondClassStandard
#   - AU example: AU_StandardDelivery,AU_ExpressDelivery
# EBAY_SHIPPING_SERVICES=USPSParcel,USPSPriority

# Weight + dimension units used when the draft has weightLbs/boxDimensionsIn.
# US sellers leave as default; metric sellers set to KILOGRAM / CENTIMETER.
# Valid weight units: POUND, OUNCE, KILOGRAM, GRAM
# Valid dimension units: INCH, CENTIMETER
# EBAY_WEIGHT_UNIT=POUND
# EBAY_DIMENSION_UNIT=INCH


# ────── Backward-compat single-env layout (deprecated) ──────
# Older versions of this skill used unprefixed keys (EBAY_APP_ID etc.) and
# only supported one environment at a time. Those still work as a fallback —
# if you have e.g. EBAY_APP_ID but no EBAY_SANDBOX_APP_ID / EBAY_PRODUCTION_APP_ID,
# the bare key is used regardless of EBAY_ENV. New setups should prefer the
# prefixed keys above so you can keep both environments configured at once.
